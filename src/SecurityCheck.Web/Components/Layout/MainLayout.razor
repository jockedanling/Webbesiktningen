@inherits LayoutComponentBase

<header class="site-header">
    <nav aria-label="Huvudmeny" class="site-nav">
        <ul>
            <li><a href="#processen">Processen</a></li>
            <li><a href="#hur-vi-har-tankt">Hur vi har tänkt</a></li>
        </ul>
        <a class="site-logo" href="#hem"><img src="img/webbesiktningen-logo-stacked-dark.svg" alt="Webbesiktningen, till toppen" /></a>
        <ul>
            <li><a href="#team">Team</a></li>
            <li><a href="#faq">FAQ</a></li>
        </ul>
    </nav>
</header>

<main>
    @Body
</main>

<footer class="site-footer">
    <div class="site-footer-inner">
        <p class="site-footer-about">
            <strong>Webbesiktningen</strong> är ett skolprojekt i kursen APR400 vid Högskolan Väst, byggt av Erik och Joakim 2026.
        </p>
        <p>Resultatet är en hälsokontroll av tre grundinställningar, inte en garanti för att webbplatsen är säker.</p>
        <p class="site-footer-links">
            <a href="https://github.com/jockedanling/Webbesiktningen">Källkoden på GitHub</a>
            <a href="#hem">Till toppen</a>
        </p>
    </div>
</footer>

<div id="blazor-error-ui" data-nosnippet>
    Ett oväntat fel har uppstått.
    <a href="." class="reload">Ladda om sidan</a>
    <button class="dismiss" aria-label="Stäng">X</button>
</div>
